+/*
+ * pgvector's in-memory layout of sys.vector (a varlena).  Kept local so the TDS
+ * extension does not need pgvector's headers.
+ */
+typedef struct PgVectorData
+{
+	int32		vl_len_;
+	int16		dim;
+	int16		unused;
+	float		x[FLEXIBLE_ARRAY_MEMBER];
+} PgVectorData;
+
+/* MS-TDS 2.2.5.5.7: vector header = magic, version, dimension count, element type, 3 reserved bytes */
+#define TDS_VECTOR_HEADER_SIZE		8
+#define TDS_VECTOR_MAGIC			0xA9
+#define TDS_VECTOR_LAYOUT_VERSION	0x01
+#define TDS_VECTOR_ELEMENT_FLOAT32	0x00
+#define TDS_VECTOR_MAX_BYTES		8000
+
+/* --------------------------------
+ * TdsSendTypeVector - sends a sys.vector value as native TDS VECTOR (float32)
+ * --------------------------------
+ */
+int
+TdsSendTypeVector(FmgrInfo *finfo, Datum value, void *vMetaData)
+{
+	PgVectorData *vec = (PgVectorData *) PG_DETOAST_DATUM(value);
+	int			dim = vec->dim;
+	int			len = TDS_VECTOR_HEADER_SIZE + dim * (int) sizeof(float);
+	uint8_t		header[TDS_VECTOR_HEADER_SIZE];
+	int			rc;
+
+	if (len > TDS_VECTOR_MAX_BYTES)
+		ereport(ERROR,
+				(errcode(ERRCODE_PROGRAM_LIMIT_EXCEEDED),
+				 errmsg("vector with %d dimensions is too large for the TDS vector type (maximum is %d)",
+						dim, (TDS_VECTOR_MAX_BYTES - TDS_VECTOR_HEADER_SIZE) / (int) sizeof(float))));
+
+	header[0] = TDS_VECTOR_MAGIC;
+	header[1] = TDS_VECTOR_LAYOUT_VERSION;
+	header[2] = (uint8_t) (dim & 0xFF);
+	header[3] = (uint8_t) ((dim >> 8) & 0xFF);
+	header[4] = TDS_VECTOR_ELEMENT_FLOAT32;
+	header[5] = header[6] = header[7] = 0;
+
+	if ((rc = TdsPutInt16LE(len)) == 0 &&
+		(rc = TdsPutbytes(header, sizeof(header))) == 0)
+		rc = TdsPutbytes(vec->x, dim * (int) sizeof(float));	/* little-endian host only */
+
+	if ((Pointer) vec != DatumGetPointer(value))
+		pfree(vec);
+	return rc;
+}
+
+/* --------------------------------
+ * TdsRecvTypeVector - converts a native TDS VECTOR parameter to sys.vector
+ * --------------------------------
+ */
+Datum
+TdsRecvTypeVector(const char *message, const ParameterToken token)
+{
+	const unsigned char *data = (const unsigned char *) message + token->dataOffset;
+	int			len = token->len;
+	int			dim;
+	PgVectorData *result;
+
+	if (len < TDS_VECTOR_HEADER_SIZE ||
+		data[0] != TDS_VECTOR_MAGIC ||
+		data[1] != TDS_VECTOR_LAYOUT_VERSION)
+		ereport(ERROR,
+				(errcode(ERRCODE_PROTOCOL_VIOLATION),
+				 errmsg("The incoming tabular data stream (TDS) remote procedure call (RPC) protocol stream is incorrect. "
+						"Parameter %d (\"%s\"): invalid vector header.",
+						token->paramOrdinal + 1, token->paramMeta.colName.data)));
+
+	if (data[4] != TDS_VECTOR_ELEMENT_FLOAT32)
+		ereport(ERROR,
+				(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+				 errmsg("Only float32 vectors are supported (parameter %d, \"%s\")",
+						token->paramOrdinal + 1, token->paramMeta.colName.data)));
+
+	dim = data[2] | (data[3] << 8);
+	if (dim < 1 || len != TDS_VECTOR_HEADER_SIZE + dim * (int) sizeof(float))
+		ereport(ERROR,
+				(errcode(ERRCODE_PROTOCOL_VIOLATION),
+				 errmsg("The incoming tabular data stream (TDS) remote procedure call (RPC) protocol stream is incorrect. "
+						"Parameter %d (\"%s\"): vector length does not match its dimension count.",
+						token->paramOrdinal + 1, token->paramMeta.colName.data)));
+
+	result = (PgVectorData *) palloc0(offsetof(PgVectorData, x) + sizeof(float) * dim);
+	SET_VARSIZE(result, offsetof(PgVectorData, x) + sizeof(float) * dim);
+	result->dim = (int16) dim;
+	memcpy(result->x, data + TDS_VECTOR_HEADER_SIZE, sizeof(float) * dim);
+
+	/* pgvector does not allow NaN or infinity either */
+	for (int i = 0; i < dim; i++)
+	{
+		if (isnan(result->x[i]) || isinf(result->x[i]))
+			ereport(ERROR,
+					(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+					 errmsg("NaN and infinity are not allowed in vectors")));
+	}
+
+	return PointerGetDatum(result);
+}
