+/*
+ * Raw-tree walker that renames the T-SQL pseudo-tables in a MERGE ... OUTPUT list:
+ *   inserted.<col> => new.<col>   (NULL for a row removed by a DELETE action)
+ *   deleted.<col>  => old.<col>   (NULL for a row created by an INSERT action)
+ * PostgreSQL 18 resolves new / old in a MERGE ... RETURNING list. Source columns such as
+ * i._Position are valid in RETURNING as written. $action has already been rewritten to
+ * merge_action() by the ANTLR layer.
+ */
+static bool
+tsql_merge_output_rename_walker(Node *node, void *context)
+{
+	if (node == NULL)
+		return false;
+
+	if (IsA(node, ColumnRef))
+	{
+		ColumnRef  *cref = (ColumnRef *) node;
+
+		if (list_length(cref->fields) >= 2 && IsA(linitial(cref->fields), String))
+		{
+			char	   *qualifier = strVal(linitial(cref->fields));
+
+			if (pg_strcasecmp(qualifier, "inserted") == 0)
+				linitial(cref->fields) = makeString(pstrdup("new"));
+			else if (pg_strcasecmp(qualifier, "deleted") == 0)
+				linitial(cref->fields) = makeString(pstrdup("old"));
+		}
+		return false;
+	}
+
+	return raw_expression_tree_walker(node, tsql_merge_output_rename_walker, context);
+}
+
+static void
+tsql_merge_output_to_returning(ReturningClause *returning)
+{
+	ListCell   *lc;
+
+	foreach(lc, returning->exprs)
+		(void) tsql_merge_output_rename_walker((Node *) lfirst(lc), NULL);
+}
