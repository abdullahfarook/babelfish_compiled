 /*
+ * Rewrite $action in a T-SQL MERGE OUTPUT clause into merge_action(), which returns
+ * 'INSERT' / 'UPDATE' / 'DELETE' just like $action does.
+ *
+ * Only $action is rewritten here. The OUTPUT keyword and the inserted / deleted pseudo-tables are
+ * left as T-SQL and resolved by the backend grammar (tsql_MergeOutputStmt), because the text
+ * produced by this pass is parsed by ANTLR again, e.g. for the body of a CREATE PROCEDURE, so it
+ * must remain valid T-SQL. merge_action() is an ordinary function call to that second pass.
+ */
+static void
+rewrite_merge_output_refs(antlr4::tree::ParseTree *node)
+{
+	if (auto *tn = dynamic_cast<antlr4::tree::TerminalNode *>(node))
+	{
+		if (tn->getSymbol()->getType() == TSqlParser::DOLLAR_ACTION)
+			rewritten_query_fragment.emplace(std::make_pair(tn->getSymbol()->getStartIndex(),
+				std::make_pair(tn->getText(), std::string("merge_action()"))));
+		return;
+	}
+	for (auto child : node->children)
+		rewrite_merge_output_refs(child);
+}
