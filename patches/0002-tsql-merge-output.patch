+/*
+ * T-SQL MERGE ... OUTPUT. PostgreSQL 18 has MERGE ... RETURNING, so the OUTPUT list becomes the
+ * RETURNING list; tsql_merge_output_to_returning() maps inserted / deleted onto the new / old
+ * row of each merge action. OUTPUT ... INTO is not supported.
+ */
+tsql_MergeOutputStmt:
+			opt_with_clause MERGE INTO relation_expr_opt_alias
+			USING table_ref
+			ON a_expr
+			merge_when_list
+			tsql_output_clause
+				{
+					MergeStmt  *m = makeNode(MergeStmt);
+
+					m->withClause = $1;
+					m->relation = $4;
+					m->sourceRelation = $6;
+					m->joinCondition = $8;
+					m->mergeWhenClauses = $9;
+					m->returningClause = (ReturningClause *) $10;
+					tsql_merge_output_to_returning(m->returningClause);
+
+					$$ = (Node *) m;
+				}
+		;
