# Component pins for the Babelfish bundle. Source of truth for build.sh and CI.
BABELFISH_VERSION=6.3.0
ANTLR4_VERSION=4.13.2
PGVECTOR_VERSION=0.8.5
PGBOUNCER_VERSION=1.24.1
# CI clones these refs; local builds use bind-mounted checkouts instead.
BABELFISH_PG_REPO=https://github.com/babelfish-for-postgresql/postgresql_modified_for_babelfish.git
BABELFISH_PG_REF=BABEL_6_3_STABLE__PG_18_7
BABELFISH_EXT_REPO=https://github.com/babelfish-for-postgresql/babelfish_extensions.git
BABELFISH_EXT_REF=BABEL_6_3_STABLE
